# NÃO é preciso copiar este arquivo: "npm run setup" (na raiz) cria o backend/.env
# automaticamente, com chaves aleatórias. Ele serve só como referência.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Banco PostgreSQL embutido (scripts/db.mjs)
LIFEHUB_DB_PORT=55433
LIFEHUB_DB_USER=lifehub
LIFEHUB_DB_PASSWORD=
LIFEHUB_DB_NAME=lifehub
DATABASE_URL=postgresql://lifehub:SENHA@127.0.0.1:55433/lifehub

# Tokens de acesso (48+ bytes aleatórios cada)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Chaves de 32 bytes em hexadecimal (64 caracteres). Nunca reutilize entre si.
PASSWORD_RESET_ENCRYPTION_KEY=
CPF_ENCRYPTION_KEY=
CPF_HASH_KEY=
FILE_ENCRYPTION_KEY=

APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_DIR=./storage
MAILBOX_DIR=./mailbox
LOCAL_JOBS=true
CRON_SECRET=
LOG_LEVEL=info
